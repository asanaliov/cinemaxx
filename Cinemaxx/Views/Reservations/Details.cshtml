@model Cinemaxx.ViewModels.ReservationDisplayViewModel

@section Head {
    <link rel="stylesheet" href="~/css/payment.css" asp-append-version="true"/>
}

@{
    ViewData["Title"] = "Reservation Details";

    var (statusIcon, statusHeading, statusSubtext, statusModifier, statusLabel) = Model.Status switch
    {
        ReservationStatus.Confirmed => (
            "✓",
            L["Reservation confirmed!"].Value,
            L["Your booking details are ready."].Value,
            "is-confirmed",
            L["Paid"].Value),
        ReservationStatus.Cancelled when Model.ExpiresAtUtc.HasValue => (
            "⏱",
            L["This reservation expired"].Value,
            L["The payment window closed and the seats have been released."].Value,
            "is-expired",
            L["Expired"].Value),
        ReservationStatus.Cancelled => (
            "✕",
            L["Reservation cancelled"].Value,
            L["This booking is no longer valid and the seats have been released."].Value,
            "is-cancelled",
            L["Cancelled"].Value),
        _ => (
            "→",
            L["Complete your payment"].Value,
            L["Your seats are being held — finish payment before the hold expires."].Value,
            "is-pending",
            L["Awaiting payment"].Value)
    };

    var canCancel = Model.Status != ReservationStatus.Cancelled && Model.ScreeningStartTime > DateTime.UtcNow;
}

<section class="confirmation-page">
    <div class="confirmation-card">
        <div class="confirmation-status">
            <span class="confirmation-icon @statusModifier" aria-hidden="true">@statusIcon</span>
            <div>
                <h1>@statusHeading</h1>
                <p>@statusSubtext</p>
            </div>
        </div>

        @if (TempData["PaymentSuccessMessage"] is string paymentSuccessMessage)
        {
            <div class="confirmation-alert">@paymentSuccessMessage</div>
        }

        @if (TempData["ReservationNoticeMessage"] is string reservationNoticeMessage)
        {
            <div class="confirmation-alert is-notice">@reservationNoticeMessage</div>
        }

        <div class="confirmation-details">
            <div class="confirmation-row">
                <span>@L["Movie"]</span>
                <strong>@Model.MovieTitle</strong>
            </div>
            <div class="confirmation-row">
                <span>@L["Hall"]</span>
                <strong>@Model.HallName</strong>
            </div>
            <div class="confirmation-row">
                <span>@L["Screening"]</span>
                <strong>@Model.ScreeningStartTime.ToString("dd/MM/yyyy HH:mm")</strong>
            </div>
            <div class="confirmation-row">
                <span>@L["Seats"]</span>
                <strong>@(Model.Seats.Any() ? string.Join(", ", Model.Seats.Select(s => L["Row {0}, Seat {1}", s.Row, s.Number].Value)) : L["No seats assigned"].Value)</strong>
            </div>
            <div class="confirmation-row">
                <span>@L["Tickets"]</span>
                <strong>@Model.NumberOfTickets</strong>
            </div>
            <div class="confirmation-row">
                <span>@L["Status"]</span>
                <strong>@statusLabel</strong>
            </div>

            <hr />

            <div class="confirmation-total">
                <span>@L["Total"]</span>
                <strong>@Model.TotalPrice.ToMoney()</strong>
            </div>
        </div>

        <div class="confirmation-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">@L["Back"]</a>
            @if (canCancel)
            {
                <form asp-action="Cancel" asp-route-id="@Model.Id" asp-route-token="@(ViewBag.GuestToken as string)" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">@L["Cancel reservation"]</button>
                </form>
            }
        </div>
    </div>
</section>
