@model IEnumerable<Cinemaxx.ViewModels.ReservationDisplayViewModel>

@{
    ViewData["Title"] = "All Reservations";
}

<div class="page-header">
    <h2>@L["All Reservations"]</h2>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">🎟️</div>
        <p class="text-muted">@L["No reservations found."]</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>@L["User"]</th>
                <th>@L["Movie"]</th>
                <th>@L["Screening"]</th>
                <th>@L["Seats"]</th>
                <th>@L["Tickets"]</th>
                <th class="text-end">@L["Total"]</th>
                <th>@L["Status"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@(r.CustomerEmail ?? "-")</td>
                    <td class="fw-semibold">@r.MovieTitle</td>
                    <td>@r.ScreeningStartTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (r.Seats.Any())
                        {
                            <span class="small text-muted">@string.Join(", ", r.Seats.Select(s => $"{s.Row}{s.Number}"))</span>
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </td>
                    <td>@r.NumberOfTickets</td>
                    <td class="text-end text-nowrap">@r.TotalPrice.ToMoney()</td>
                    <td>
                        @if (r.Status == Cinemaxx.Models.ReservationStatus.Confirmed)
                        {
                            <span class="badge bg-success">@L[r.Status.ToString()]</span>
                        }
                        else if (r.Status == Cinemaxx.Models.ReservationStatus.Cancelled)
                        {
                            <span class="badge bg-danger">@L[r.Status.ToString()]</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@L[r.Status.ToString()]</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
