@model Cinemaxx.Models.Reservation

@{
    ViewData["Title"] = "Cancel reservation";
}

<div class="delete-confirm-card card mx-auto mt-4">
    <div class="card-header d-flex align-items-center gap-2">
        <span>⚠️</span>
        <strong>@L["Cancel reservation"]</strong>
    </div>
    <div class="card-body">
        <p class="mb-1">@L["Cancel reservation for"]:</p>
        <p class="fw-bold fs-5 mb-0">@Model.Screening.Movie.Title</p>
        <p class="text-muted mb-3">@Model.Screening.StartTime.ToString("dd MMM yyyy, HH:mm")</p>
        <p class="text-muted small">@L["Your seats will be released and the booking can't be restored."]</p>
        <div class="d-flex gap-2 mt-4">
            <form asp-action="Cancel" method="post">
                <input type="hidden" asp-for="Id"/>
                @if (ViewBag.GuestToken is string guestToken)
                {
                    <input type="hidden" name="token" value="@guestToken"/>
                }
                <button class="btn btn-danger" type="submit">@L["Cancel reservation"]</button>
            </form>
            <a href="javascript:history.back()" class="btn btn-outline-secondary">@L["Keep reservation"]</a>
        </div>
    </div>
</div>
