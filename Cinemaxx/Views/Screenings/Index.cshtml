@model IEnumerable<Cinemaxx.Models.Screening>

@{
    ViewData["Title"] = "Screenings";
}

<div class="page-header">
    <h2>@L["Screenings"]</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">+ @L["Create screening"]</a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">🕒</div>
        <p class="text-muted">@L["No screenings found."]</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>@L["Movie"]</th>
                <th>@L["Hall"]</th>
                <th>@L["Start Time"]</th>
                <th>@L["Price"]</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td class="fw-semibold">@s.Movie.Title</td>
                    <td>@s.CinemaHall.Name</td>
                    <td>@s.StartTime.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@s.Price.ToMoney()</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary">@L["Details"]</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-secondary ms-1">@L["Edit"]</a>
                            <a asp-action="Delete" asp-route-id="@s.Id" class="btn btn-sm btn-danger ms-1">@L["Delete"]</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
