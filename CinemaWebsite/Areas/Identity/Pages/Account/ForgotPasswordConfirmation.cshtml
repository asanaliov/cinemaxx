@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<h1>@L["Check your email"]</h1>
<p>
    @L["Please check your email to reset your password."]
</p>
<div class="auth-links">
    <a class="btn btn-primary" asp-page="./Login">@L["Back to login"]</a>
</div>
