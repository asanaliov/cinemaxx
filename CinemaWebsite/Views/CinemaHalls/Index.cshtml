@model IEnumerable<CinemaWebsite.Models.CinemaHall>

@{
    ViewData["Title"] = "Cinema Halls";
}

<div class="page-header">
    <h2>@L["Cinema Halls"]</h2>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">+ @L["Create hall"]</a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">🏛️</div>
        <p class="text-muted">@L["No cinema halls found."]</p>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
            <tr>
                <th>@L["Name"]</th>
                <th>@L["Number"]</th>
                <th>@L["Capacity"]</th>
                <th>@L["Type"]</th>
                <th>@L["Available"]</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td class="fw-semibold">@h.Name</td>
                    <td>@h.Number</td>
                    <td>@L["{0} seats", h.Capacity]</td>
                    <td><span class="badge bg-secondary">@h.HallType</span></td>
                    <td>
                        @if (h.IsAvailable)
                        {
                            <span class="text-success fw-semibold">@L["Yes"]</span>
                        }
                        else
                        {
                            <span class="text-muted">@L["No"]</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@h.Id" class="btn btn-sm btn-outline-secondary">@L["Details"]</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit" asp-route-id="@h.Id" class="btn btn-sm btn-outline-secondary ms-1">@L["Edit"]</a>
                            <a asp-action="Delete" asp-route-id="@h.Id" class="btn btn-sm btn-danger ms-1">@L["Delete"]</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
