@model CinemaWebsite.Models.Movie

@{
    ViewData["Title"] = Model.Title;

    string? trailer = Model.TrailerUrl;
    string? embedUrl = null;

    if (!string.IsNullOrWhiteSpace(trailer))
    {
        if (trailer.Contains("youtube.com/embed/"))
            embedUrl = trailer;
        else if (trailer.Contains("watch?v="))
            embedUrl = trailer.Replace("watch?v=", "embed/");
        else if (trailer.Contains("youtu.be/"))
            embedUrl = $"https://www.youtube.com/embed/{trailer.Split('/').Last()}";
    }
}

@if (TempData["ScreeningStartedMessage"] is string screeningStartedMessage)
{
    <div class="alert alert-warning" role="alert">@screeningStartedMessage</div>
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← @L["Back to Movies"]</a>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm ms-2">@L["Edit"]</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm ms-2">@L["Delete"]</a>
    }
</div>

<div class="movie-hero mb-5">
    <div class="movie-hero-backdrop" style="background-image: url('@(string.IsNullOrWhiteSpace(Model.PosterUrl) ? "https://placehold.co/400x600/1A1814/D4A341?text=No+Poster" : Model.PosterUrl)');" aria-hidden="true"></div>
    <div class="movie-hero-shade" aria-hidden="true"></div>
    
    <div class="movie-hero-content">
        <div class="row g-4 align-items-center">
            <!-- Poster -->
            <div class="col-sm-5 col-md-4 col-lg-3">
                <div class="movie-hero-poster">
                    <img src="@(string.IsNullOrWhiteSpace(Model.PosterUrl) ? "https://placehold.co/400x600/1A1814/D4A341?text=No+Poster" : Model.PosterUrl)"
                         alt="@L["{0} poster", Model.Title]"/>
                </div>
            </div>
            
            <!-- Movie Details -->
            <div class="col-sm-7 col-md-8 col-lg-9 d-flex flex-column gap-3">
                <div>
                    <h1 class="movie-hero-title">@Model.Title</h1>
                    
                    <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
                        @if (Model.MovieGenres.Any())
                        {
                            @foreach (var mg in Model.MovieGenres)
                            {
                                <span class="genre-chip">@mg.Genre.Name</span>
                            }
                        }
                        @if (Model.Rating > 0)
                        {
                            <span class="rating-chip">★ @Model.Rating</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="movie-hero-synopsis">@Model.Description</p>
                    }
                </div>

                <!-- Quick Metadata Grid -->
                <div class="row g-3 mt-1 movie-facts">
                    @if (!string.IsNullOrWhiteSpace(Model.Director))
                    {
                        <div class="col-6 col-md-4">
                            <div class="fact-label">@L["Director"]</div>
                            <div class="fw-semibold text-white">@Model.Director</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Cast))
                    {
                        <div class="col-6 col-md-4">
                            <div class="fact-label">@L["Cast"]</div>
                            <div class="fw-semibold text-white text-truncate" title="@Model.Cast">@Model.Cast</div>
                        </div>
                    }
                    @if (Model.Duration > 0)
                    {
                        <div class="col-6 col-md-4">
                            <div class="fact-label">@L["Duration"]</div>
                            <div class="fw-semibold text-white">@L["{0} min", Model.Duration]</div>
                        </div>
                    }
                    <div class="col-6 col-md-4">
                        <div class="fact-label">@L["Release"]</div>
                        <div class="fw-semibold text-white">@Model.ReleaseDate.ToString("MMM yyyy")</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.AgeRating))
                    {
                        <div class="col-6 col-md-4">
                            <div class="fact-label">@L["Age Rating"]</div>
                            <div class="fw-semibold text-white">@Model.AgeRating</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Language))
                    {
                        <div class="col-6 col-md-4">
                            <div class="fact-label">@L["Language"]</div>
                            <div class="fw-semibold text-white">@Model.Language @(string.IsNullOrWhiteSpace(Model.SubtitleLanguage) ? "" : " " + L["(Sub: {0})", Model.SubtitleLanguage])</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-5">
    <!-- Screenings Section -->
    <div class="col-lg-7 col-xl-8">
        <div class="d-flex justify-content-between align-items-end mb-4 border-bottom border-secondary border-opacity-25 pb-3">
            <div>
                <h3 class="fw-bold mb-1">@L["Book Tickets"]</h3>
                @if (ViewBag.FilteredDay != null)
                {
                    <p class="text-muted mb-0">@L["Showing available times for"] <strong>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetDayName((DayOfWeek)ViewBag.FilteredDay)</strong></p>
                }
                else
                {
                    <p class="text-muted mb-0">@L["Select a showtime below."]</p>
                }
            </div>
        </div>

        @if (Model.Screenings.Any())
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var screening in Model.Screenings.OrderBy(s => s.StartTime))
                {
                    <div class="card showtime-card">
                        <div class="card-body p-3 p-md-4">
                            <div class="row align-items-center g-3 text-center text-md-start">
                                <div class="col-12 col-md-3">
                                    <div class="fact-label">@L["Date"]</div>
                                    <div class="fw-bold fs-5">@screening.StartTime.ToString("dd MMM")</div>
                                </div>
                                <div class="col-6 col-md-3 border-md-start border-secondary border-opacity-25 ps-md-4">
                                    <div class="fact-label">@L["Time"]</div>
                                    <div class="showtime-time">@screening.StartTime.ToString("HH:mm")</div>
                                </div>
                                <div class="col-6 col-md-3 border-start border-secondary border-opacity-25 ps-4">
                                    <div class="fact-label">@L["Hall"]</div>
                                    <div class="fw-semibold">@screening.CinemaHall.Name</div>
                                    <div class="text-success small fw-bold mt-1">@screening.Price.ToMoney()</div>
                                </div>
                                <div class="col-12 col-md-3 text-md-end mt-4 mt-md-0">
                                    <a asp-controller="Reservations"
                                       asp-action="Create"
                                       asp-route-screeningId="@screening.Id"
                                       class="btn btn-primary w-100 py-2 rounded-pill fw-bold">@L["Get Tickets"]</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state card">
                <div class="empty-icon fs-1 mb-3">🎟️</div>
                <h5 class="fw-bold text-white">@L["No Screenings Available"]</h5>
                <p class="text-muted">@L["There are currently no upcoming showtimes scheduled for this movie."]</p>
            </div>
        }
    </div>

    <!-- Trailer Section -->
    <div class="col-lg-5 col-xl-4">
        <h4 class="fw-bold mb-4">@L["Trailer"]</h4>
        @if (!string.IsNullOrWhiteSpace(embedUrl))
        {
            <div class="ratio ratio-16x9 trailer-frame">
                <iframe src="@embedUrl"
                        title="@L["{0} trailer", Model.Title]"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen>
                </iframe>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(trailer))
        {
            <a href="@trailer" target="_blank" rel="noopener" class="card trailer-placeholder text-decoration-none">
                <div class="fs-1 mb-2">▶️</div>
                <div class="fw-bold text-white">@L["Watch Trailer on YouTube"] ↗</div>
            </a>
        }
        else
        {
            <div class="card trailer-placeholder">
                <div class="text-muted">@L["No trailer available"]</div>
            </div>
        }
    </div>
</div>
