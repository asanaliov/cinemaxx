@model CinemaWebsite.Models.Screening

@{
    ViewData["Title"] = Model.Movie.Title;
}

<div class="page-header">
    <h2>@Model.Movie.Title</h2>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm">@L["Edit"]</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">@L["Delete"]</a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← @L["Back"]</a>
    </div>
</div>

<div class="form-page-card">
    <div class="card">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="text-muted small">@L["Hall"]</div>
                    <div class="fw-semibold">@Model.CinemaHall.Name</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">@L["Price"]</div>
                    <div class="fw-semibold">@Model.Price.ToMoney()</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">@L["Start Time"]</div>
                    <div class="fw-semibold">@Model.StartTime.ToString("dd MMM yyyy, HH:mm")</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-muted small">@L["Ends"]</div>
                    <div class="fw-semibold">@Model.EndTime.ToString("dd MMM yyyy, HH:mm")</div>
                </div>
            </div>
            <a asp-controller="Reservations" asp-action="Create" asp-route-screeningId="@Model.Id" class="btn btn-primary mt-4">@L["Open seat map"]</a>
        </div>
    </div>
</div>
