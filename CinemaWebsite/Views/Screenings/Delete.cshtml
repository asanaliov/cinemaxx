@model CinemaWebsite.Models.Screening
<h3>@L["Delete Screening"]</h3><div asp-validation-summary="ModelOnly" class="text-danger"></div><p>@L["Delete screening for"] <strong>@Model.Movie.Title</strong> @L["in"] <strong>@Model.CinemaHall.Name</strong>?</p>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" /><button class="btn btn-danger" type="submit">@L["Delete"]</button></form>
