@model CinemaWebsite.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-header">
    <h2>@L["Admin Dashboard"]</h2>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <h5 class="text-muted mb-3 mt-2">@L["Movies & Screenings"]</h5>
    </div>
    
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "Movies")">
            <span class="stat-label">@L["Total Movies"]</span>
            <span class="stat-value text-primary">@Model.TotalMovies</span>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "Movies", new { status = "NowShowing" })">
            <span class="stat-label">@L["Now showing"]</span>
            <span class="stat-value text-success">@Model.NowShowingMovies</span>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "Movies", new { status = "ComingSoon" })">
            <span class="stat-label">@L["Coming soon"]</span>
            <span class="stat-value" style="color: var(--accent);">@Model.ComingSoonMovies</span>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "Screenings")">
            <span class="stat-label">@L["Screenings"]</span>
            <span class="stat-value">@Model.TotalScreenings</span>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <h5 class="text-muted mb-3 mt-2">@L["Reservations"]</h5>
    </div>
    
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "Reservations")">
            <span class="stat-label">@L["Total"]</span>
            <span class="stat-value text-primary">@Model.TotalReservations</span>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "Reservations")">
            <span class="stat-label">@L["Confirmed"]</span>
            <span class="stat-value text-success">@Model.ConfirmedReservations</span>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "Reservations")">
            <span class="stat-label">@L["Cancelled"]</span>
            <span class="stat-value text-danger">@Model.CancelledReservations</span>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <h5 class="text-muted mb-3 mt-2">@L["System & Content"]</h5>
    </div>
    
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "CinemaHalls")">
            <span class="stat-label">@L["Cinema Halls"]</span>
            <span class="stat-value">@Model.TotalHalls</span>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "Genres")">
            <span class="stat-label">@L["Genres"]</span>
            <span class="stat-value">@Model.TotalGenres</span>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "News")">
            <span class="stat-label">@L["Published News"]</span>
            <span class="stat-value">@Model.PublishedNews</span>
        </a>
    </div>
    <div class="col-6 col-md-4 col-lg-3">
        <a class="stat-card" href="@Url.Action("Index", "ContactMessages")">
            <span class="stat-label">@L["Unread Messages"]</span>
            <span class="stat-value @(Model.UnreadContactMessages > 0 ? "text-danger" : "text-success")">
                @Model.UnreadContactMessages
            </span>
        </a>
    </div>
</div>
