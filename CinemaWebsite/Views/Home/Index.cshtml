@model CinemaWebsite.ViewModels.HomeViewModel

@section Head {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true"/>
}

@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "home-page";
}

<section class="home-hero">
    <div class="home-hero-copy">
        <p class="home-eyebrow">@(Model.NowShowingMovies.Any() ? "Now showing at Cinemaxx" : "Cinemaxx")</p>
        <h1 class="home-hero-title">Your next movie night starts&nbsp;here.</h1>
        <p class="home-hero-lead">See what's playing, pick your seats and book in under a minute.</p>
        <div class="home-hero-actions">
            <a class="home-hero-btn" asp-controller="Movies" asp-action="Index" asp-route-status="NowShowing">
                Browse movies <span aria-hidden="true">→</span>
            </a>
            <a class="home-hero-link" asp-controller="Movies" asp-action="Index" asp-route-status="ComingSoon">Coming soon</a>
        </div>
    </div>

    @if (Model.NowShowingMovies.Any())
    {
        <div class="marquee-container">
            <div class="marquee-track">
                <!-- Group 1 -->
                <div class="marquee-group">
                    @for (int i = 0; i < 2; i++)
                    {
                        foreach (var m in Model.NowShowingMovies)
                        {
                            <div class="marquee-item">
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">
                                    <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://placehold.co/400x600/1A1814/D4A341?text=No+Poster" : m.PosterUrl)" alt="@m.Title">
                                </a>
                            </div>
                        }
                    }
                </div>
                <!-- Duplicate group for seamless looping -->
                <div class="marquee-group" aria-hidden="true">
                    @for (int i = 0; i < 2; i++)
                    {
                        foreach (var m in Model.NowShowingMovies)
                        {
                            <div class="marquee-item">
                                <a asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id" tabindex="-1">
                                    <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://placehold.co/400x600/1A1814/D4A341?text=No+Poster" : m.PosterUrl)" alt="">
                                </a>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</section>

@if (Model.NowShowingMovies.Any())
{
    <section class="home-section">
        <div class="section-heading-row">
            <h3>Now Showing</h3>
            <a asp-controller="Movies" asp-action="Index" asp-route-status="NowShowing">Browse all →</a>
        </div>
        <div class="home-card-grid">
            @foreach (var m in Model.NowShowingMovies)
            {
                <article class="home-movie-card">
                    <a class="movie-poster-wrap" asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">
                        <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://placehold.co/400x600/1A1814/D4A341?text=No+Poster" : m.PosterUrl)"
                             alt="@m.Title poster" loading="lazy"/>
                    </a>
                    <div class="movie-card-content">
                        <h4><a asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">@m.Title</a></h4>
                        <p>@m.ReleaseDate.ToString("dd MMM yyyy")</p>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Model.ComingSoonMovies.Any())
{
    <section class="home-section">
        <div class="section-heading-row">
            <h3>Coming Soon</h3>
            <a asp-controller="Movies" asp-action="Index" asp-route-status="ComingSoon">See schedule →</a>
        </div>
        <div class="home-card-grid">
            @foreach (var m in Model.ComingSoonMovies)
            {
                <article class="home-movie-card">
                    <a class="movie-poster-wrap" asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">
                        <img src="@(string.IsNullOrWhiteSpace(m.PosterUrl) ? "https://placehold.co/400x600/1A1814/D4A341?text=No+Poster" : m.PosterUrl)"
                             alt="@m.Title poster" loading="lazy"/>
                    </a>
                    <div class="movie-card-content">
                        <h4><a asp-controller="Movies" asp-action="Details" asp-route-id="@m.Id">@m.Title</a></h4>
                        <p>@m.ReleaseDate.ToString("dd MMM yyyy")</p>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (Model.LatestNews.Any())
{
    <section class="home-section">
        <div class="section-heading-row">
            <h3>Latest News</h3>
            <a asp-controller="News" asp-action="Index">All news →</a>
        </div>
        <div class="news-card-list">
            @foreach (var n in Model.LatestNews)
            {
                <div class="news-card-item">
                    <span class="news-dot" aria-hidden="true"></span>
                    <a asp-controller="News" asp-action="Details" asp-route-id="@n.Id">@n.Title</a>
                </div>
            }
        </div>
    </section>
}

@if (Model.Services.Any())
{
    <section class="home-section">
        <div class="section-heading-row">
            <h3>Our Services</h3>
            <a asp-controller="Services" asp-action="Index">View all →</a>
        </div>
        <div class="services-grid">
            @foreach (var s in Model.Services)
            {
                <div class="service-card">
                    <h5>@s.Name</h5>
                    @if (!string.IsNullOrWhiteSpace(s.Description))
                    {
                        <p>@(s.Description.Length > 90 ? s.Description[..90] + "…" : s.Description)</p>
                    }
                </div>
            }
        </div>
    </section>
}
