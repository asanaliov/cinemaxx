@model IEnumerable<CinemaWebsite.Models.ContactMessage>
<h3>@L["Contact Messages"]</h3>
<table class="table"><tr><th>@L["From"]</th><th>@L["Subject"]</th><th>@L["Date"]</th><th>@L["Read"]</th><th></th></tr>@foreach (var m in Model){<tr><td>@m.Name (@m.Email)</td><td>@m.Subject</td><td>@m.SentAt</td><td>@(m.IsRead ? L["Yes"] : L["No"])</td><td><a asp-action="Details" asp-route-id="@m.Id">@L["Details"]</a></td></tr>}</table>
